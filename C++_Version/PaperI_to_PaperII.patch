+  // ---- Paper II canonical grades (1,3) and (1,4) (quadrupole type) -----------
+  //   K13 = G^2 m1 m2 m3 a1/(c^2 a2^3 l2^3) [F0 (1-3cos^2 i) + F2 sin^2 i cos 2w1]
+  //         Paper II Eqs. (42)-(44); coded in the vector form of Eq. (D4),
+  //         with G2 = F2/e1^2 (regular at e1 = 0)
+  //   K14 = G^2 m1 m2 m3 a1^2/(c^2 a2^4 l2^5) [cZ Z + cY Y]
+  //         Paper II Eqs. (50)-(53)
+  //   Z = -2 + 12 e^2 + 6 (j.n2)^2 - 30 (e.n2)^2               (Eq. (40))
+  //   Y = 10[(e.u2)^2-(e.v2)^2] - 2[(j.u2)^2-(j.v2)^2]         (Eq. (51))
+  //   (octupole-type (1,4) terms are O(|m1-m2|/m3) relative and omitted)
+  // The flow is obtained from the Milankovitch equations, Eq. (D5), with the
+  // gradients of K13 + K14 taken by central differences (step 1e-6).
+  // Diagnostic environment switches (multiplicative factors, default 1):
+  //   CANON13  -> K13,  CANON14 -> K14,  CANON14Z -> cZ Z,  CANON14Y -> cY Y.
+  // They are read once, at the first evaluation (static locals).
+  if (kozai->get_canon()){
+    double M0 = m1+m2, M3c = M0+m3, nuc = m1*m2/sqr(M0);
+    double l2 = j2n;
+    vec v2c = n2^u2;
+    double pre13 = sqr(G)*m1*m2*m3*a1/(sqr(c)*pow(a2,3.)*pow(l2,3.));
+    double pre14 = sqr(G)*m1*m2*m3*sqr(a1)/(sqr(c)*pow(a2,4.)*pow(l2,5.));
+    double cZ = -((7.+18.*l2+29.*sqr(e2n))*sqr(M0)+(11.+36.*l2+52.*sqr(e2n))*M0*m3+(3.+18.*l2+27.*sqr(e2n))*sqr(m3))/(32.*M0*M3c);
+    double cY = -(1.-l2)/(1.+l2)*(12.*(3.*sqr(l2)+2.*l2+1.)*sqr(M0)+2.*(39.*sqr(l2)+46.*l2+23.)*M0*m3+6.*(7.*sqr(l2)+10.*l2+5.)*sqr(m3))/(128.*M0*M3c);
+    auto Phi = [&](vec j, vec e)->double{
+      double E2 = e*e, J2 = j*j, jz = j*n2, ez = e*n2;
+      double et = sqrt(fmax(1.-E2,1e-300));
+      double Xe;                                   // (2(eta-1)+e^2(4eta-3))/e^4
+      if (E2 < 1e-4) Xe = -2.25 - 0.625*E2;
+      else Xe = (2.*(et-1.) + E2*(4.*et-3.))/sqr(E2);
+      double F0 = (54. + 3.*E2 - (84.+36.*E2)/et - nuc*(10.-13.*E2))/32.;
+      double G2 = (3./32.)*(3.*(1.-nuc) - 2.*(2.+3.*E2)*Xe/et);
+      double K13 = pre13*( F0*(1.-3.*sqr(jz)/J2) + G2*(E2*(1.-sqr(jz)/J2) - 2.*sqr(ez)) );
+      double Z = -2. + 12.*E2 + 6.*sqr(jz) - 30.*sqr(ez);
+      double Y = 10.*(sqr(e*u2)-sqr(e*v2c)) - 2.*(sqr(j*u2)-sqr(j*v2c));
+      double K14 = pre14*(cZ*Z + cY*Y);
+      static double f13 = getenv("CANON13") ? atof(getenv("CANON13")) : 1.0;
+      static double f14 = getenv("CANON14") ? atof(getenv("CANON14")) : 1.0;
+      static double fZ  = getenv("CANON14Z") ? atof(getenv("CANON14Z")) : 1.0;
+      static double fY  = getenv("CANON14Y") ? atof(getenv("CANON14Y")) : 1.0;
+      K14 = pre14*(fZ*cZ*Z + fY*cY*Y);
+      return f13*K13 + f14*K14;
+    };
+    vec gj, ge;
+    double hh = 1e-6;
+    for (int k=0;k<3;k++){
+      vec dk = 0.; dk[k] = hh;
+      gj[k] = (Phi(j1+dk,e1) - Phi(j1-dk,e1))/(2.*hh);
+      ge[k] = (Phi(j1,e1+dk) - Phi(j1,e1-dk))/(2.*hh);
+    }
+    dj1dt += (-1./L1)*((j1^gj) + (e1^ge));
+    de1dt += (-1./L1)*((e1^gj) + (j1^ge));
+  }
